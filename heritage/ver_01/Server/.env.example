# ====================================================================
# 세종특별자치시 AI 문화유산 스마트 플랫폼 - 로컬 및 배포 환경 변수 템플릿
# 복사하여 .env 파일을 생성하고 실제 값을 설정하여 사용하십시오.
# ====================================================================

# 1. OpenAI API 설정 (Agentic RAG 분석, Embedding 및 LLM 활용)
OPENAI_API_KEY=your_openai_api_key_here

# 2. Supabase 데이터베이스 및 Vector Store 설정
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. 공공데이터포털 연동 키 (한국관광공사 TourAPI, 기상청 초단기실시간예보 등)
TOUR_API_KEY=your_tourapi_decoding_service_key_here
KMA_API_KEY=your_weather_decoding_service_key_here
PUBLIC_DATA_API_KEY=your_general_public_data_key_here

# 4. 지도 서비스 연동 키 (Kakao Map, TMap)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_app_key_here
KAKAO_MOBILITY_API_KEY=your_kakao_mobility_api_key_here

TMAP_APP_KEY=your_tmap_api_app_key_here

# 5. 에이전트 시스템 매개변수 설정
MAP_PROVIDER=kakao                     # kakao 또는 tmap 설정
MAX_AGENT_RETRY=3                       # RAG 피드백 루프 최대 재시도 횟수
DEFAULT_SEARCH_K=10                     # 리트리버 문서 조회 수
DEFAULT_ROUTE_RADIUS_KM=5.0             # 주변 관광지 검색 반경 (km)
